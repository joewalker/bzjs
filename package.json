{
  "name": "@joewalker/bzjs",
  "version": "0.4.0",
  "description": "A TypeScript client for the Bugzilla REST API, focused on Mozilla's bugzilla.mozilla.org.",
  "author": "Joe Walker <jwalker@mozilla.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/joewalker/bzjs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joewalker/bzjs.git"
  },
  "bugs": {
    "url": "https://github.com/joewalker/bzjs/issues"
  },
  "keywords": [
    "bugzilla"
  ],
  "type": "module",
  "bin": {
    "bz-search": "./dist/bin/bz-search.js",
    "bz-show": "./dist/bin/bz-show.js",
    "bzjs": "./dist/bin/bzjs.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist cache/tsconfig.build.tsbuildinfo && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist cache/tsconfig.build.tsbuildinfo",
    "format": "oxfmt",
    "lint": "oxlint",
    "prepack": "pnpm build",
    "test:watch": "NODE_ENV=test vitest",
    "test": "NODE_ENV=test vitest run",
    "tsc": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "nyc": "18.0.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "typescript": "7.0.2",
    "v8-to-istanbul": "9.3.0",
    "vitest": "4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
