{
  "name": "@joewalker/bzjs",
  "version": "0.5.0",
  "description": "A TypeScript client for the Bugzilla REST API, focused on Mozilla's bugzilla.mozilla.org.",
  "author": "Joe Walker <jwalker@mozilla.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/joewalker/bzjs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joewalker/bzjs.git"
  },
  "bugs": {
    "url": "https://github.com/joewalker/bzjs/issues"
  },
  "keywords": [
    "bugzilla"
  ],
  "type": "module",
  "bin": {
    "bz-component-teams": "./dist/bin/bz-component-teams.js",
    "bz-help": "./dist/bin/bz-help.js",
    "bz-search": "./dist/bin/bz-search.js",
    "bz-show": "./dist/bin/bz-show.js",
    "bzjs": "./dist/bin/bzjs.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist cache/tsconfig.build.tsbuildinfo && tsc -p tsconfig.build.json && chmod +x dist/bin/*.js",
    "clean": "rm -rf dist cache/tsconfig.build.tsbuildinfo",
    "format": "oxfmt",
    "lint": "oxlint",
    "prepack": "pnpm build",
    "test:watch": "NODE_ENV=test vitest",
    "test": "NODE_ENV=test vitest run",
    "tsc": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "nyc": "18.0.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2",
    "v8-to-istanbul": "9.3.0",
    "vitest": "5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.18.0"
}
